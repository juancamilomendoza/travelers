# Copia este archivo a .env solo para desarrollo local con `netlify dev`.
# En producción estas variables van en Netlify > Site configuration > Environment variables.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: Google Maps (Places API New) para direcciones, fotos y contactos reales.
GOOGLE_MAPS_API_KEY=
# "full" (teléfono, web y calificación) o "basic" (solo dirección, foto y Maps).
GOOGLE_PLACES_LEVEL=full
